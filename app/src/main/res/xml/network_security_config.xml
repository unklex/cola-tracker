<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Только HTTPS. Нарочно БЕЗ <domain-config>: Ktor CIO вызывает checkServerTrusted без имени
         хоста, и при наличии доменных правил Android бросает «Domain specific configurations
         require that hostname aware checkServerTrusted ...» — приложение не может подключиться.
         Для локальной разработки по HTTP см. app/src/debug/res/xml/network_security_config.xml. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
